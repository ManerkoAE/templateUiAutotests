<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>My.portfolio</groupId>
    <artifactId>DemoQARu</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Единственный источник версии Java: свойство читает maven-compiler-plugin -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Версии плагинов -->
        <maven-surefire-plugin.version>3.2.2</maven-surefire-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <allure-maven-plugin.version>3.0.3</allure-maven-plugin.version>
        <aspectj.version>1.9.25.1</aspectj.version>

        <!-- Версии библиотек -->
        <allure.version>2.35.3</allure.version>
        <allure.report.version>2.46.1</allure.report.version>
        <assertj.version>3.27.0</assertj.version>
        <commons-io.version>2.22.0</commons-io.version>
        <junit.jupiter.version>5.10.3</junit.jupiter.version>
        <selenium.version>4.47.0</selenium.version>
        <logback.version>1.6.3</logback.version>
        <lombok.version>1.18.34</lombok.version>
        <owner.version>1.0.12</owner.version>
        <faker.version>2.7.0</faker.version>
    </properties>

    <build>
        <plugins>
            <!-- Версия Java берётся из maven.compiler.release, отдельный <release> не нужен -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <!-- Имена параметров должны попадать в байт-код, иначе Allure
                         не подставит их в названия шагов вида @Step("Войти как {login}") -->
                    <parameters>true</parameters>
                    <!-- Lombok указывается явно: так неявное включение annotation processing
                         не важно (в JDK 23+ оно выключено по умолчанию), а версия обработчика
                         фиксирована и не зависит от classpath -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Плагин для запуска тестов -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                    <systemProperties>
                        <property>
                            <name>allure.results.directory</name>
                            <value>${project.build.directory}/allure-results</value>
                        </property>
                    </systemProperties>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                        <scope>runtime</scope>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Плагин Allure для генерации отчёта -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven-plugin.version}</version>
                <configuration>
                    <reportVersion>${allure.report.version}</reportVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- JUnit 5: агрегатор приносит api, params и engine одной зависимостью -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Selenium: драйверы подбирает встроенный Selenium Manager (4.6+) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Логирование: logback-core приходит транзитивно, отдельно объявлять не нужно -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- Lombok: @Slf4j вместо ручного LoggerFactory.getLogger в каждом классе.
             scope=provided — библиотека нужна только на этапе компиляции -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Owner: конфигурация через интерфейсы -->
        <dependency>
            <groupId>org.aeonbits.owner</groupId>
            <artifactId>owner</artifactId>
            <version>${owner.version}</version>
        </dependency>

        <!-- Datafaker: генерация тестовых данных -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${faker.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Добавление библиотеки транслитерации-->
        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>79.1</version>
        </dependency>
        <!-- Allure для JUnit 5 -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-jupiter</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- AssertJ: читаемые проверки -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- commons-io: рекурсивная очистка каталога результатов Allure (AllureResultsCleaner) -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
